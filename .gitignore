# Runtime state created on each PC
LocalFUT/.runtime/
__pycache__/
*.py[cod]
*.log
*.sqlite3
*.sqlite3-*
*.sqlite3.*
certs/
*.key
*.pem

# Game data extracted from FIFA 19 and content derived from third-party
# sites are never committed. Only project-authored files stay tracked; the
# playable data ships in the release ZIP.
LocalFUT/server/data/*
!LocalFUT/server/data/SOURCES.md
!LocalFUT/server/data/pack_defs.json
!LocalFUT/server/data/pack_weights.json

# Generated by the package build
PACKAGE_SHA256.txt
BUILD_INFO.json

# Proprietary game files and archives
FIFA19.exe
*.dll
*.exe
*.cas
*.toc
*.sb
*.cat
*.big
*.dds
*.db
*.DB
*.zip
*.rar
*.7z
